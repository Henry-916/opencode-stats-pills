  "type": "module",
  "description": "DSH-inspired performance and usage pills for OpenCode V2",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opentui",
    "tui",
    "token-usage",
    "cost-tracking",
    "statusbar"
