    "@opentui/solid": "^0.5.17",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "1.9.10",
    "esbuild": "^0.25.0",
    "solid-js": "1.9.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
